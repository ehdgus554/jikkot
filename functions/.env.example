# Server public configuration. Use separate projects for preview and production.
FIREBASE_WEB_API_KEY=your-public-web-api-key
ALLOWED_ORIGINS=https://your-review.workers.dev
PUBLIC_API_URL=https://asia-northeast3-your-project.cloudfunctions.net/api
KAKAO_CLIENT_ID=your-rest-api-key
NAVER_CLIENT_ID=your-client-id
# KAKAO_CLIENT_SECRET and NAVER_CLIENT_SECRET belong in Firebase Secret Manager.
# Set only after the collection/retention policy is reviewed. No implicit production default.
OPERATION_RETENTION_DAYS=

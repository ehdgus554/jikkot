# Public browser configuration; never put Admin credentials/provider secrets here.
VITE_FIREBASE_API_KEY=your-public-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=your-public-app-id
VITE_API_URL=https://asia-northeast3-your-project.cloudfunctions.net/api
# Only honored by DEV builds with a demo- project. False in preview/production.
VITE_USE_FIREBASE_EMULATORS=false

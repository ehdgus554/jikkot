rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function member(uid) {
      return request.auth != null && request.auth.uid == uid &&
        request.auth.token.firebase.sign_in_provider != 'google.com' &&
        exists(/databases/$(database)/documents/profiles/$(uid)) &&
        get(/databases/$(database)/documents/profiles/$(uid)).data.active == true;
    }
    match /profiles/{uid} {
      allow read: if member(uid);
      allow write: if false;
      match /records/{record} { allow read: if member(uid); allow write: if false; }
    }
    match /{document=**} { allow read, write: if false; }
  }
}

{
  "name": "jikkot-ver9",
  "version": "9.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vinext build",
    "build:preparation": "JIKKOT_PREPARATION=true vinext build",
    "start": "vinext start",
    "test": "npm run content:check && npm run build && node --test tests/ui-components.test.mjs && npm run test:service",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "deploy": "tsx scripts/check-deploy.ts && npm run content:check && npm run build && tsx scripts/check-worker-target.ts jikkot-ver9 && wrangler deploy",
    "deploy:preparation": "JIKKOT_PREPARATION=true npm run deploy",
    "typecheck": "tsc --noEmit --incremental false && npm --prefix functions run build",
    "content:check": "tsx scripts/validate-content.ts",
    "test:service": "tsx --test tests/service/*.test.ts",
    "emulators": "node scripts/firebase-local.mjs start",
    "test:emulators": "node scripts/firebase-local.mjs exec",
    "test:integration": "tsx --test tests/integration/*.test.ts",
    "test:browser": "playwright test",
    "test:worker": "node scripts/worker-smoke.mjs",
    "test:preparation": "node scripts/preparation-smoke.mjs",
    "deploy:preview": "tsx scripts/check-deploy.ts && npm run content:check && CLOUDFLARE_ENV=preview npm run build && tsx scripts/check-worker-target.ts jikkot-review && wrangler deploy",
    "build:local-worker": "JIKKOT_LOCAL_WORKER=true vinext build"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.19.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-is": "^19.3.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "firebase-tools": "14.22.0",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}

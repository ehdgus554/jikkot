{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jikkot",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "FIREBASE_AUTH_HELPER_HOST": "jikkot.firebaseapp.com",
    "FIREBASE_PROJECT_ID": "jikkot",
    "FIREBASE_WEB_API_KEY": "AIzaSyBJ-p7Tios-w0yy8Y3anfoJrANmQQ-Pbdk",
    "ALLOWED_ORIGINS": "https://jikkot.ehdgus554.workers.dev"
  },
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./dist/client", "binding": "ASSETS" },
  "observability": { "enabled": false },
  "triggers": { "crons": ["*/10 * * * *"] },
  "env": {
    "preview": {
      "name": "jikkot-review",
      "workers_dev": true,
      "preview_urls": true,
      "vars": {
        "FIREBASE_AUTH_HELPER_HOST": "jikkot.firebaseapp.com",
        "FIREBASE_PROJECT_ID": "jikkot",
        "FIREBASE_WEB_API_KEY": "AIzaSyBJ-p7Tios-w0yy8Y3anfoJrANmQQ-Pbdk",
        "ALLOWED_ORIGINS": "https://jikkot-review.ehdgus554.workers.dev",
        "DEPLOYMENT_STAGE": "review",
        "REVIEW_ENABLED": "true",
        "REVIEW_ALLOWED_UIDS": "",
        "GROWTH_ENABLED": "false",
        "AI_ENABLED": "false"
      },
      "assets": { "directory": "./dist/client", "binding": "ASSETS" },
    },
  },
}

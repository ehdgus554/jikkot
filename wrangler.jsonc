{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jikkot-ver9",
  "workers_dev": true,
  "preview_urls": true,
  "vars": {
    "FIREBASE_AUTH_HELPER_HOST": "jikkot.firebaseapp.com",
    "FIREBASE_PROJECT_ID": "jikkot",
    "FIREBASE_WEB_API_KEY": "AIzaSyBJ-p7Tios-w0yy8Y3anfoJrANmQQ-Pbdk",
